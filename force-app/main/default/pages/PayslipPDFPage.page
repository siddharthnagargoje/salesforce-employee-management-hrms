<apex:page standardController="Payslip__c"
    extensions="PayslipPDFController"
    renderAs="pdf"
    applyHtmlTag="false"
    applyBodyTag="false"
    showHeader="false"
    sidebar="false"
    standardStylesheets="false"
>
    <html>
        <head>
            <style>
                @page {
                    size: A4 portrait;
                    margin: 10mm 12mm 12mm 12mm;
                    @bottom-right {
                        content: "Page " counter(page) " of " counter(pages);
                        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                        font-size: 7.5pt;
                        color: #8b95a5;
                    }
                    @bottom-left {
                        content: "HRMS 360 - Strictly Confidential and Proprietary";
                        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                        font-size: 7.5pt;
                        color: #8b95a5;
                    }
                }

                * {
                    box-sizing: border-box;
                }

                body {
                    margin: 0;
                    padding: 0;
                    background: #ffffff;
                    color: #1e293b;
                    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                    font-size: 8.5pt;
                    line-height: 1.35;
                }

                .payslip-container {
                    width: 100%;
                    border: 1.5px solid #0f1f38;
                    border-collapse: collapse;
                }

                table.fixed-table {
                    width: 100%;
                    table-layout: fixed;
                    border-collapse: collapse;
                }

                /* Header Styling */
                .header-cell {
                    background-color: #0f1f38;
                    color: #ffffff;
                    padding: 16px 20px;
                }

                .gold-divider {
                    height: 4px;
                    line-height: 4px;
                    font-size: 1px;
                    background-color: #d4af37;
                    padding: 0;
                    margin: 0;
                }

                .brand-badge {
                    display: inline-block;
                    background-color: #d4af37;
                    color: #0f1f38;
                    font-weight: 900;
                    font-size: 11pt;
                    padding: 4px 9px;
                    border-radius: 4px;
                    letter-spacing: 0.5px;
                    margin-right: 8px;
                    vertical-align: middle;
                }

                .company-title {
                    font-size: 14.5pt;
                    font-weight: bold;
                    letter-spacing: 0.5px;
                    vertical-align: middle;
                    color: #ffffff;
                }

                .company-tagline {
                    font-size: 7.5pt;
                    color: #cbd5e1;
                    margin-top: 4px;
                    letter-spacing: 0.3px;
                }

                .header-right {
                    text-align: right;
                    vertical-align: middle;
                }

                .doc-heading {
                    font-size: 13pt;
                    font-weight: bold;
                    letter-spacing: 1px;
                    color: #d4af37;
                    text-transform: uppercase;
                    margin-bottom: 3px;
                }

                .doc-subheading {
                    font-size: 8pt;
                    color: #ffffff;
                    font-weight: 600;
                }

                /* Metadata Bar */
                .metadata-bar {
                    background-color: #f8fafc;
                    border-bottom: 1.5px solid #e2e8f0;
                    padding: 10px 18px;
                }

                .meta-col {
                    width: 25%;
                    vertical-align: top;
                    padding: 2px 8px;
                }

                .meta-col-border {
                    border-right: 1px solid #cbd5e1;
                }

                .meta-label {
                    font-size: 6.8pt;
                    font-weight: bold;
                    color: #64748b;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    margin-bottom: 2px;
                }

                .meta-val {
                    font-size: 9pt;
                    font-weight: bold;
                    color: #0f1f38;
                }

                .status-chip {
                    display: inline-block;
                    padding: 2px 8px;
                    border-radius: 10px;
                    font-size: 7.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                }

                .status-paid {
                    background-color: #dcfce7;
                    color: #15803d;
                    border: 1px solid #86efac;
                }

                .status-approved {
                    background-color: #dbeafe;
                    color: #1d4ed8;
                    border: 1px solid #93c5fd;
                }

                .status-pending {
                    background-color: #fef3c7;
                    color: #b45309;
                    border: 1px solid #fde68a;
                }

                .status-default {
                    background-color: #f1f5f9;
                    color: #475569;
                    border: 1px solid #cbd5e1;
                }

                /* Section Styling */
                .section-container {
                    padding: 12px 18px;
                }

                .section-header {
                    font-size: 9.5pt;
                    font-weight: bold;
                    color: #0f1f38;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    border-left: 3.5px solid #0f1f38;
                    padding-left: 8px;
                    margin-bottom: 8px;
                }

                /* Employee Information Table */
                .info-box {
                    width: 100%;
                    border-collapse: collapse;
                    border: 1px solid #cbd5e1;
                }

                .info-label-cell {
                    width: 20%;
                    background-color: #f1f5f9;
                    font-size: 7.2pt;
                    font-weight: bold;
                    color: #475569;
                    text-transform: uppercase;
                    letter-spacing: 0.3px;
                    padding: 7px 10px;
                    border: 1px solid #cbd5e1;
                }

                .info-val-cell {
                    width: 30%;
                    background-color: #ffffff;
                    font-size: 8.5pt;
                    font-weight: 600;
                    color: #0f1f38;
                    padding: 7px 10px;
                    border: 1px solid #cbd5e1;
                }

                /* Compensation Table */
                .comp-table {
                    width: 100%;
                    border-collapse: collapse;
                    border: 1px solid #cbd5e1;
                }

                .comp-th {
                    background-color: #0f1f38;
                    color: #ffffff;
                    font-size: 7.5pt;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    padding: 7px 10px;
                    border: 1px solid #0f1f38;
                }

                .comp-th-right {
                    text-align: right;
                }

                .comp-td {
                    padding: 7px 10px;
                    font-size: 8.5pt;
                    border-left: 1px solid #cbd5e1;
                    border-right: 1px solid #cbd5e1;
                    border-bottom: 1px solid #e2e8f0;
                }

                .comp-td-amount {
                    text-align: right;
                    font-weight: 600;
                    color: #0f1f38;
                }

                .comp-earning {
                    color: #15803d;
                }

                .comp-deduction {
                    color: #b91c1c;
                }

                .subtotal-row td {
                    background-color: #f1f5f9;
                    border-top: 1.5px solid #0f1f38;
                    border-bottom: 1.5px solid #0f1f38;
                    font-weight: bold;
                    color: #0f1f38;
                }

                /* Net Pay Banner */
                .net-banner-container {
                    padding: 4px 18px 10px 18px;
                }

                .net-banner-table {
                    width: 100%;
                    border-collapse: collapse;
                    background-color: #0f1f38;
                    border-radius: 4px;
                }

                .net-left-cell {
                    width: 60%;
                    padding: 12px 16px;
                    vertical-align: middle;
                }

                .net-title {
                    font-size: 11pt;
                    font-weight: bold;
                    color: #ffffff;
                    letter-spacing: 0.5px;
                }

                .net-desc {
                    font-size: 7.5pt;
                    color: #d4af37;
                    margin-top: 2px;
                }

                .net-right-cell {
                    width: 40%;
                    padding: 12px 16px;
                    text-align: right;
                    vertical-align: middle;
                }

                .net-amount {
                    font-size: 15pt;
                    font-weight: bold;
                    color: #d4af37;
                    letter-spacing: 0.5px;
                }

                /* Signatures */
                .signature-container {
                    padding: 10px 18px 16px 18px;
                }

                .sig-cell {
                    width: 50%;
                    vertical-align: bottom;
                    text-align: center;
                    padding: 4px 20px;
                }

                .sig-box-inner {
                    border: 1px dashed #cbd5e1;
                    background-color: #f8fafc;
                    padding: 10px 12px;
                    border-radius: 4px;
                }

                .sig-badge {
                    display: inline-block;
                    background-color: #ecfdf5;
                    border: 1px solid #10b981;
                    color: #047857;
                    padding: 3px 8px;
                    border-radius: 4px;
                    font-size: 7.5pt;
                    font-weight: bold;
                    letter-spacing: 0.5px;
                    margin-bottom: 5px;
                }

                .sig-line {
                    width: 80%;
                    border-top: 1px solid #0f1f38;
                    margin: 25px auto 4px auto;
                }

                .sig-title {
                    font-size: 7.5pt;
                    font-weight: bold;
                    color: #0f1f38;
                    text-transform: uppercase;
                    letter-spacing: 0.4px;
                }

                .sig-subtitle {
                    font-size: 7pt;
                    color: #64748b;
                }

                /* Footer */
                .footer-box {
                    background-color: #f8fafc;
                    border-top: 1.5px solid #e2e8f0;
                    padding: 8px 18px;
                    text-align: center;
                    font-size: 7pt;
                    color: #64748b;
                }

                .footer-highlight {
                    font-weight: bold;
                    color: #0f1f38;
                }
            </style>
        </head>

        <body>
            <table class="payslip-container">
                <!-- 1. Corporate Header -->
                <tr>
                    <td class="header-cell">
                        <table class="fixed-table">
                            <tr>
                                <td style="width: 58%; vertical-align: middle;">
                                    <span class="brand-badge">HRMS 360</span>
                                    <span class="company-title">SIDDHARTH PVT. LTD.</span>
                                    <div class="company-tagline">Corporate Human Resources &amp; Global Payroll Administration</div>
                                </td>
                                <td class="header-right" style="width: 42%; vertical-align: middle;">
                                    <div class="doc-heading">SALARY STATEMENT</div>
                                    <div class="doc-subheading">Period: {!payPeriod}</div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- Gold Accent Line -->
                <tr>
                    <td class="gold-divider">&#160;</td>
                </tr>

                <!-- 2. Metadata Bar -->
                <tr>
                    <td class="metadata-bar">
                        <table class="fixed-table">
                            <tr>
                                <td class="meta-col meta-col-border">
                                    <div class="meta-label">Payslip Slip Ref #</div>
                                    <div class="meta-val">{!payslipNumber}</div>
                                </td>
                                <td class="meta-col meta-col-border">
                                    <div class="meta-label">Salary Month / Year</div>
                                    <div class="meta-val">{!payPeriod}</div>
                                </td>
                                <td class="meta-col meta-col-border">
                                    <div class="meta-label">Disbursement Date</div>
                                    <div class="meta-val">{!generatedDate}</div>
                                </td>
                                <td class="meta-col">
                                    <div class="meta-label">Payment Status</div>
                                    <div>
                                        <span class="status-chip {!statusClass}">{!paymentStatus}</span>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- 3. Employee and Employment Information -->
                <tr>
                    <td class="section-container">
                        <div class="section-header">Employee &amp; Employment Details</div>
                        <table class="info-box">
                            <tr>
                                <td class="info-label-cell">Employee Name</td>
                                <td class="info-val-cell">{!employeeName}</td>
                                <td class="info-label-cell">Employee ID</td>
                                <td class="info-val-cell">{!employeeCode}</td>
                            </tr>
                            <tr>
                                <td class="info-label-cell">Designation</td>
                                <td class="info-val-cell">{!designation}</td>
                                <td class="info-label-cell">Work Location</td>
                                <td class="info-val-cell">{!workLocation}</td>
                            </tr>
                            <tr>
                                <td class="info-label-cell">Registered Email</td>
                                <td class="info-val-cell">{!employeeEmail}</td>
                                <td class="info-label-cell">Pay Cycle</td>
                                <td class="info-val-cell">Monthly (30 Days)</td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- 4. Compensation and Salary Breakdown -->
                <tr>
                    <td class="section-container" style="padding-top: 2px;">
                        <div class="section-header">Earnings &amp; Deductions Breakdown</div>
                        <table class="comp-table">
                            <colgroup>
                                <col style="width: 32%" />
                                <col style="width: 18%" />
                                <col style="width: 32%" />
                                <col style="width: 18%" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th class="comp-th">Earnings Component</th>
                                    <th class="comp-th comp-th-right">Amount</th>
                                    <th class="comp-th">Deductions Component</th>
                                    <th class="comp-th comp-th-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="comp-td">Basic Salary</td>
                                    <td class="comp-td comp-td-amount comp-earning">{!basicSalaryFormatted}</td>
                                    <td class="comp-td">Standard Deductions / TDS</td>
                                    <td class="comp-td comp-td-amount comp-deduction">{!deductionsFormatted}</td>
                                </tr>
                                <tr>
                                    <td class="comp-td">Performance Bonus &amp; Allowances</td>
                                    <td class="comp-td comp-td-amount comp-earning">{!bonusFormatted}</td>
                                    <td class="comp-td">Provident Fund (PF) &amp; Insurance</td>
                                    <td class="comp-td comp-td-amount">₹0.00</td>
                                </tr>
                                <tr>
                                    <td class="comp-td">Special Allowances</td>
                                    <td class="comp-td comp-td-amount">₹0.00</td>
                                    <td class="comp-td">Professional Tax</td>
                                    <td class="comp-td comp-td-amount">₹0.00</td>
                                </tr>
                                <tr class="subtotal-row">
                                    <td class="comp-td" style="font-weight: bold;">Gross Earnings (A)</td>
                                    <td class="comp-td comp-td-amount" style="font-weight: bold;">{!grossSalaryFormatted}</td>
                                    <td class="comp-td" style="font-weight: bold;">Total Deductions (B)</td>
                                    <td class="comp-td comp-td-amount comp-deduction" style="font-weight: bold;">{!deductionsFormatted}</td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

                <!-- 5. Net Salary Payable Highlight Box -->
                <tr>
                    <td class="net-banner-container">
                        <table class="net-banner-table">
                            <tr>
                                <td class="net-left-cell">
                                    <div class="net-title">NET TAKE-HOME SALARY PAYABLE</div>
                                    <div class="net-desc">Net Amount (Gross Earnings minus Total Deductions)</div>
                                </td>
                                <td class="net-right-cell">
                                    <div class="net-amount">{!netSalaryFormatted}</div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- 6. Authorization and Verification Block -->
                <tr>
                    <td class="signature-container">
                        <table class="fixed-table">
                            <tr>
                                <td class="sig-cell">
                                    <div class="sig-box-inner">
                                        <div style="height: 20px;"></div>
                                        <div class="sig-line"></div>
                                        <div class="sig-title">{!employeeName}</div>
                                        <div class="sig-subtitle">Employee Signature / Acknowledged</div>
                                    </div>
                                </td>
                                <td class="sig-cell">
                                    <div class="sig-box-inner">
                                        <div>
                                            <span class="sig-badge">&#10003; DIGITALLY VERIFIED</span>
                                        </div>
                                        <div class="sig-title" style="margin-top: 4px;">HR &amp; Payroll Controller</div>
                                        <div class="sig-subtitle">HRMS 360 Corporate Operations</div>
                                        <div style="font-size: 6.5pt; color: #94a3b8; margin-top: 2px;">
                                            Valid System Audit Trail Token: {!payslipNumber}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- 7. Footer and Legal Disclaimer -->
                <tr>
                    <td class="footer-box">
                        <div class="footer-highlight">
                            This is an automated system-generated payroll statement under HRMS 360 platform. No physical signature is required.
                        </div>
                        <div style="margin-top: 2px;">
                            For payroll queries, contact HRMS Payroll Helpdesk. Confidential document intended exclusively for the named recipient.
                        </div>
                    </td>
                </tr>
            </table>
        </body>
    </html>
</apex:page>